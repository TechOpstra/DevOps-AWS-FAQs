#logrotation structure:


# shell script to find disk space

#!/bin/bash

# Set threshold percentage (e.g., 80%)
THRESHOLD=10

# Get disk usage for all mounted partitions
df -h | awk 'NR>1 {print $5 " " $1}' | while read output
do
    # Extract the percentage and the partition
    usage=$(echo $output | awk '{print $1}' | sed 's/%//')
    partition=$(echo $output | awk '{print $2}')

    # Check if usage exceeds the threshold
    if [ "$usage" -ge "$THRESHOLD" ]; then
        echo "Warning: Partition $partition is $usage% full!" 
    fi
done






